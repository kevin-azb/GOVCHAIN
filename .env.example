# Copy this file to .env and fill in real values before deploying to Amoy.
# Never commit the real .env file.

# RPC endpoint for Polygon Amoy testnet, e.g. from Alchemy or Infura
AMOY_RPC_URL=

# Private key of the deployer wallet (needs test MATIC from an Amoy faucet)
# Keep this in .env ONLY. Never hardcode it, never commit it.
PRIVATE_KEY=
